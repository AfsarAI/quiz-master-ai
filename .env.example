# ==============================================================================
# Quiz-Master-AI Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Quiz-Master-AI"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-cryptographically-secure-random-key-with-openssl"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Host Port Mappings (Configured to prevent local conflicts)
HOST_POSTGRES_PORT=5435
HOST_REDIS_PORT=6382
HOST_MINIO_PORT=9002
HOST_MINIO_CONSOLE_PORT=9003
HOST_API_PORT=8000
HOST_WEB_PORT=3001

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5435
POSTGRES_USER=quizmaster
POSTGRES_PASSWORD=quizmaster_secret
POSTGRES_DB=quizmaster_ai
DATABASE_URL="postgresql+asyncpg://quizmaster:quizmaster_secret@localhost:5435/quizmaster_ai"
# Fallback local SQLite (useful for quick local tests without Docker)
# DATABASE_URL="sqlite+aiosqlite:///./quizmaster_ai.db"

# Redis Cache & Task Broker
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_URL="redis://localhost:6382/0"

# S3 / MinIO Object Storage
S3_ENDPOINT="http://localhost:9002"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="quizmaster-documents"
S3_REGION="us-east-1"
LOCAL_STORAGE_PATH="./storage_uploads"

# AI & LLM Providers (LiteLLM / Gemini / OpenAI)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
DEFAULT_LLM_MODEL="gemini/gemini-3.8-flash"
DEFAULT_EMBEDDING_MODEL="gemini/gemini-embedding-001"
EMBEDDING_DIMENSION=1536

# CORS Whitelist (JSON array)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:3001", "http://localhost:8081", "http://localhost:19006"]'
